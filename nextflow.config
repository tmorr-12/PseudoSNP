manifest {
    name = 'PseudoSNP'
    author = 'Tom Morrison'
    description = 'Pseudomonas aeruginosa SNP analysis'
    version = '0.0.1'
    nextflowVersion = '>=26.04.6'
}

params {
    refs = ""
    input = null

    help = false
    outdir = "./results"
    
    publish_dir_mode = 'copy'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

dag {
    enabled = true
    file = "${params.outdir}/pipeline-info/pipeline_dag.mmd"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline-info/execution_trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}

profiles {
    standard {
        process {
            executor = 'local'
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "/pub63/tom22/singularity_cache"
        }
    }
}
